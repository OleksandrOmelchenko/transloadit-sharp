# normalize line endings for text files
* text=auto

# source and project files
*.cs text diff=csharp
*.csproj text
*.props text
*.targets text
*.sln text eol=crlf
*.slnx text eol=crlf
*.config text
*.json text
*.xml text
*.yml text
*.yaml text
*.md text
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.nupkg binary
*.snk binary
*.dll binary
*.exe binary
*.pdb binary
